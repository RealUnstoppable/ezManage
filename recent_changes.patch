+
+    .footer-bottom {
+        justify-content: center;
+        text-align: center;
+    }
+}
+.status-indicator.down { color: #a3a316; background-color: rgba(22, 163, 74, 0.1); }
+.nav-logo{
+    font-size: 1.5rem;
+    font-weight: 800;
