+                    <div class="absolute inset-0 bg-emerald-50 dark:bg-emerald-900/10 -z-10"></div>
+                    <div class="text-4xl font-black text-emerald-500 mb-2" id="predictionDay">Today</div>
+                    <div class="text-[10px] font-black uppercase tracking-widest text-slate-400">Forecasting For</div>
+                </div>
+            </div>
+
+            <div class="card p-0 overflow-hidden">
+                <div class="p-6 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 flex items-center justify-between">
+                    <div class="flex items-center gap-3">
+                        <i data-lucide="brain" class="text-sky-500"></i>
+                        <h3 class="text-xl font-black">AI Prediction Results</h3>
+                    </div>
+                    <button id="importAllBtn" onclick="importAllPredictions()" class="btn btn-sm btn-accent hidden">Import All</button>
+                </div>
+
+                <div id="resultsContainer" class="p-6">
+                    <div class="text-center py-12 text-slate-500 font-medium" id="resultsPlaceholder">
+                        Authenticating and fetching shift data...
+                    </div>
+                </div>
+            </div>
+
+        </div>
+    </main>
+
+    <script>
+
+        lucide.createIcons();
+
+        const savedTheme = localStorage.getItem('managerProTheme');
+        if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
+            document.body.classList.add('dark-mode');
+        }
+
+        function toggleSidebar() { document.getElementById('sidebar').classList.toggle('open'); }
+        function navTo(viewId) { localStorage.setItem('navTo', viewId); window.location.href = 'index.html'; }
+        function handleNavAccountClick() { navTo('profile'); }
+        function signOut() { auth.signOut().then(() => window.location.href = 'index.html'); }
+
+        const firebaseConfig = {
+            apiKey: "AIzaSyBgrI9HwJPSc5b4pu2Egsv4DE7shNwptSw",
+            authDomain: "dts-hub-website.firebaseapp.com",
+            projectId: "dts-hub-website",
+            storageBucket: "dts-hub-website.firebasestorage.app",
+            messagingSenderId: "48345990988",
+            appId: "1:48345990988:web:e3662c9b508168546471e9",
+            measurementId: "G-ZN3YJPHVGX"
+        };
+
+        if (!firebase.apps.length) { firebase.initializeApp(firebaseConfig); }
+        const auth = firebase.auth();
+        const db = firebase.firestore();
+        const storage = firebase.storage();
+
+        let maxValues = {};
+        let uniqueItems = new Set();
+        let trainingData = [];
+
+        let currentUser = null;
+        let currentUserData = null;
+        let latestPrediction = null;
+
+        (function() {
+            const tempUid = localStorage.getItem('ezManage_lastUid');
+            if (tempUid) {
+                const localAI = localStorage.getItem(`ezManage_aiEnabled_${tempUid}`);
+                const localCloud = localStorage.getItem(`ezManage_cloudEnabled_${tempUid}`);
+                if (localAI === 'false' || localCloud === 'false') {
+                    document.getElementById('aiRestrictionModal').classList.remove('hidden');
+                }
+            }
+        })();
+
+        auth.onAuthStateChanged((user) => {
+            currentUser = user;
+            if (user) {
+                localStorage.setItem('ezManage_lastUid', user.uid);
+                db.collection("users").doc(user.uid).onSnapshot(doc => {
+                    if (doc.exists) {
+                        currentUserData = doc.data();
+                        checkAIRestrictions(currentUserData);
+                    }
+                });
+                updateStatus('Fetching Data', 'amber');
+            } else {
+                updateStatus('Not Logged In', 'red');
+                document.getElementById('resultsPlaceholder').innerHTML = `
+                    <p class="mb-4">You must be logged in to view your AI stock predictions.</p>
+                    <a href="index.html" class="btn btn-outline">Go to Login</a>
+                `;
+            }
+        });
+
+        function updateStatus(text, color) {
+            const ind = document.getElementById('statusIndicator');
+            ind.innerHTML = `<span class="w-2 h-2 rounded-full bg-${color}-500 ${color === 'amber' || color === 'sky' ? 'animate-pulse' : ''} shadow-[0_0_8px_rgba(var(--tw-colors-${color}-500),0.8)]"></span> ${text}`;
+        }
+
+        function checkAIRestrictions(data) {
+            const modal = document.getElementById('aiRestrictionModal');
+            if (!data.cloudSyncEnabled || data.aiTrainingEnabled === false) {
+                updateStatus('AI Disabled', 'amber');
+                modal.classList.remove('hidden');
+                document.getElementById('resultsPlaceholder').innerHTML = `Access Restricted.`;
+                return false;
+            } else {
+                modal.classList.add('hidden');
+            }
+
+            if (document.getElementById('statShiftsFound').innerText === '0') {
+                fetchHistoryData(currentUser.uid);
+            }
+            return true;
+        }
+
+        function fetchHistoryData(uid) {
+            db.collection("users").doc(uid).get().then(async doc => {
+                if (doc.exists) {
+                    const data = doc.data();
+
+                    if (!checkAIRestrictions(data)) return;
+
+                    const history = data.shiftHistory || [];
+                    document.getElementById('statShiftsFound').innerText = history.length;
+
+                    updateStatus('Connecting to Global Model...', 'sky');
+                    try {
+                        const url = await storage.ref('models/global_model.json').getDownloadURL();
+                        const response = await fetch(url);
+                        if (response.ok) {
+                            const globalData = await response.json();
+                            runGlobalModel(globalData);
+                            return;
+                        }
+                    } catch (e) {
+                        console.log("No global model found or failed to load. Falling back to personal training.");
+                    }
+
+                    if (history.length < 3) {
+                        updateStatus('Insufficient Data', 'amber');
+                        document.getElementById('resultsPlaceholder').innerHTML = `
+                            <p class="text-amber-600 dark:text-amber-400 mb-2">Not enough shift history.</p>
+                            <p class="text-sm">The AI needs at least 3 completed shifts with inventory data to find meaningful patterns locally, and the Community Model is currently training.</p>
+                        `;
+                        return;
+                    }
+
+                    processDataForNN(history);
+                }
+            }).catch(err => {
+                console.error(err);
+                updateStatus('Error', 'red');
+                document.getElementById('resultsPlaceholder').innerText = 'Failed to load data from Firebase.';
+            });
+        }
+
+        function runGlobalModel(globalData) {
+            updateStatus('Running Community AI', 'sky');
+            const net = new brain.NeuralNetwork();
+            net.fromJSON(globalData.model);
+
+            maxValues = globalData.maxValues;
+            uniqueItems = new Set(globalData.uniqueItems);
+
+            document.getElementById('statShiftsFound').innerText = globalData.totalShifts + "+";
+            document.getElementById('statItemsTracked').innerText = uniqueItems.size;
+
+            runPrediction(net);
+        }
+
+        function getDayOfWeek(dateString) {
+            let d;
+            if (dateString.includes('-')) {
+                d = new Date(dateString + 'T12:00:00Z');
+            } else {
+                d = new Date(dateString);
+            }
+            if (isNaN(d.getTime())) return -1;
+            return d.getDay();
+        }
+
+        function parseNum(val) {
+            if (!val) return 0;
+            const parsed = parseFloat(val.toString().replace(/[^0-9.]/g, ''));
+            return isNaN(parsed) ? 0 : parsed;
+        }
+
+        function processDataForNN(history) {
+            updateStatus('Training Model...', 'sky');
+
+            history.forEach(shift => {
+                if (shift.inventory && Array.isArray(shift.inventory)) {
+                    shift.inventory.forEach(item => {
+                        if (!item.name) return;
+                        const name = item.name.trim();
+                        uniqueItems.add(name);
+
+                        if (!maxValues[name]) maxValues[name] = { bl: 0, cl: 0, fr: 0 };
+
+                        const bl = parseNum(item.bl);
+                        const cl = parseNum(item.cl);
+                        const fr = parseNum(item.fr);
+
+                        if (bl > maxValues[name].bl) maxValues[name].bl = bl;
+                        if (cl > maxValues[name].cl) maxValues[name].cl = cl;
+                        if (fr > maxValues[name].fr) maxValues[name].fr = fr;
+                    });
+                }
+            });
+
+            document.getElementById('statItemsTracked').innerText = uniqueItems.size;
+
+            Object.keys(maxValues).forEach(k => {
+                if (maxValues[k].bl === 0) maxValues[k].bl = 1;
+                if (maxValues[k].cl === 0) maxValues[k].cl = 1;
+                if (maxValues[k].fr === 0) maxValues[k].fr = 1;
+            });
+
+            trainingData = [];
+            history.forEach(shift => {
+                const day = getDayOfWeek(shift.dateSaved);
+                if (day === -1) return;
+
+                const input = {
+                    sun: day === 0 ? 1 : 0,
+                    mon: day === 1 ? 1 : 0,
+                    tue: day === 2 ? 1 : 0,
+                    wed: day === 3 ? 1 : 0,
+                    thu: day === 4 ? 1 : 0,
+                    fri: day === 5 ? 1 : 0,
+                    sat: day === 6 ? 1 : 0
+                };
+
+                const output = {};
+                Array.from(uniqueItems).forEach(name => {
+                    output[`${name}_bl`] = 0;
+                    output[`${name}_cl`] = 0;
+                    output[`${name}_fr`] = 0;
+                });
+
+                if (shift.inventory) {
+                    shift.inventory.forEach(item => {
+                        if (!item.name) return;
+                        const name = item.name.trim();
+                        output[`${name}_bl`] = parseNum(item.bl) / maxValues[name].bl;
+                        output[`${name}_cl`] = parseNum(item.cl) / maxValues[name].cl;
+                        output[`${name}_fr`] = parseNum(item.fr) / maxValues[name].fr;
+                    });
+                }
+                trainingData.push({ input, output });
+            });
+
+            setTimeout(() => {
+                const net = new brain.NeuralNetwork({ hiddenLayers: [10, 10] });
+                net.train(trainingData, { iterations: 2000, errorThresh: 0.011 });
+                runPrediction(net);
+            }, 100);
+        }
+
+        function runPrediction(net) {
+            const todayDay = new Date().getDay();
+            const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
+            document.getElementById('predictionDay').innerText = days[todayDay];
+
+            const input = {
+                sun: todayDay === 0 ? 1 : 0,
+                mon: todayDay === 1 ? 1 : 0,
+                tue: todayDay === 2 ? 1 : 0,
+                wed: todayDay === 3 ? 1 : 0,
+                thu: todayDay === 4 ? 1 : 0,
+                fri: todayDay === 5 ? 1 : 0,
+                sat: todayDay === 6 ? 1 : 0
+            };
+
+            const prediction = net.run(input);
+            latestPrediction = prediction;
+            displayResults(prediction);
+            updateStatus('Analysis Complete', 'emerald');
+            document.getElementById('statusIndicator').querySelector('span').classList.remove('animate-pulse');
+        }
+
+        function displayResults(prediction) {
+            const container = document.getElementById('resultsContainer');
+            container.innerHTML = `
+                <div class="hidden md:grid grid-cols-5 gap-4 px-4 mb-4 text-[10px] font-black uppercase tracking-widest text-slate-400 border-b border-slate-100 dark:border-slate-800 pb-2">
+                    <div class="col-span-1">Item Name</div>
+                    <div>Est. Backline</div>
+                    <div>Est. Cooler</div>
+                    <div>Est. Freezer</div>
+                    <div class="text-right">Action</div>
+                </div>
+                <div class="space-y-3" id="predictionsList"></div>
+            `;
+
+            const list = document.getElementById('predictionsList');
+
+            Array.from(uniqueItems).sort().forEach(name => {
+
+                const bl = Math.round((prediction[`${name}_bl`] || 0) * maxValues[name].bl);
+                const cl = Math.round((prediction[`${name}_cl`] || 0) * maxValues[name].cl);
+                const fr = Math.round((prediction[`${name}_fr`] || 0) * maxValues[name].fr);
+
+                if (bl === 0 && cl === 0 && fr === 0) return;
+
+                const div = document.createElement('div');
+                div.className = "grid grid-cols-2 md:grid-cols-4 gap-3 p-4 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm items-center hover:border-sky-300 dark:hover:border-sky-700 transition-colors";
+
+                div.innerHTML = `
+                    <div class="col-span-2 md:col-span-1 font-bold text-slate-800 dark:text-slate-200">${name}</div>
+
+                    <div class="flex flex-col">
+                        <span class="md:hidden text-[9px] font-black uppercase text-slate-400 mb-1">Backline</span>
+                        <span class="font-mono bg-slate-50 dark:bg-slate-800 px-3 py-1 rounded-lg border border-slate-100 dark:border-slate-700 w-full text-center">${bl}</span>
+                    </div>
+
+                    <div class="flex flex-col">
+                        <span class="md:hidden text-[9px] font-black uppercase text-slate-400 mb-1">Cooler</span>
+                        <span class="font-mono bg-sky-50 dark:bg-sky-900/20 text-sky-700 dark:text-sky-300 px-3 py-1 rounded-lg border border-sky-100 dark:border-sky-800 w-full text-center">${cl}</span>
+                    </div>
+
+                    <div class="flex flex-col">
+                        <span class="md:hidden text-[9px] font-black uppercase text-slate-400 mb-1">Freezer</span>
+                        <span class="font-mono bg-indigo-50 dark:bg-indigo-900/20 text-indigo-700 dark:text-indigo-300 px-3 py-1 rounded-lg border border-indigo-100 dark:border-indigo-800 w-full text-center">${fr}</span>
+                    </div>
+
+                    <div class="col-span-2 md:col-span-1 flex justify-end">
+                        <button onclick="importPrediction('${name}', ${bl}, ${cl}, ${fr})" class="btn btn-sm btn-accent w-full md:w-auto">Import</button>
+                    </div>
+                `;
+
+                list.appendChild(div);
+            });
+
+            if (list.children.length === 0) {
+                list.innerHTML = `<p class="text-center py-8 text-slate-500">The AI could not confidently predict any stock levels above 0. Try logging more data!</p>`;
+                document.getElementById('importAllBtn').classList.add('hidden');
+            } else {
+                document.getElementById('importAllBtn').classList.remove('hidden');
+            }
+        }
+
+        function importPrediction(name, bl, cl, fr) {
+            if (!currentUser) return alert("Please sign in to import data.");
+
+            if (confirm(`Import ${name} predictions to your active shift tracker? This will update your current draft.`)) {
+                const draft = getDraft();
+                if (!draft) return;
+
+                applyPredictionToDraft(draft, name, bl, cl, fr);
+                saveDraft(draft, `${name} imported!`);
+            }
+        }
+
+        function importAllPredictions() {
+            if (!currentUser || !latestPrediction) return;
+
+            if (confirm("Import ALL predictions to your active shift tracker? This will update your current draft for all items shown below.")) {
+                const draft = getDraft();
+                if (!draft) return;
+
+                Array.from(uniqueItems).forEach(name => {
+                    const bl = Math.round((latestPrediction[`${name}_bl`] || 0) * maxValues[name].bl);
+                    const cl = Math.round((latestPrediction[`${name}_cl`] || 0) * maxValues[name].cl);
+                    const fr = Math.round((latestPrediction[`${name}_fr`] || 0) * maxValues[name].fr);
+
+                    if (bl > 0 || cl > 0 || fr > 0) {
+                        applyPredictionToDraft(draft, name, bl, cl, fr);
+                    }
+                });
+
+                saveDraft(draft, "All predictions imported to your tracker!");
+            }
+        }
+
+        function getDraft() {
+            const draftKey = `ezManage_draft_${currentUser.uid}`;
+            let draft = localStorage.getItem(draftKey);
+            if (draft) {
+                try {
+                    return JSON.parse(draft);
+                } catch (e) {
+                    console.error("Draft parse error", e);
+                }
+            }
+            alert("No active draft found. Please open the Tracker first.");
+            return null;
+        }
+
+        function applyPredictionToDraft(draft, name, bl, cl, fr) {
+            if (!draft.inventory) draft.inventory = [];
+            let itemFound = false;
+
+            draft.inventory.forEach(item => {
+                if (item.name.trim().toLowerCase() === name.trim().toLowerCase()) {
+                    item.bl = bl.toString();
+                    item.cl = cl.toString();
+                    item.fr = fr.toString();
+                    itemFound = true;
+                }
+            });
+
+            if (!itemFound) {
+                draft.inventory.push({
+                    name: name,
+                    bl: bl.toString(),
+                    cl: cl.toString(),
+                    fr: fr.toString()
+                });
+            }
+        }
+
+        function saveDraft(draft, successMsg) {
+            const draftKey = `ezManage_draft_${currentUser.uid}`;
+            localStorage.setItem(draftKey, JSON.stringify(draft));
+
+            if (currentUserData && currentUserData.cloudSyncEnabled) {
+                db.collection('users').doc(currentUser.uid).set({ trackerDraft: draft }, { merge: true })
+                    .then(() => alert(successMsg + " (Cloud & Local Sync Complete)"))
+                    .catch(err => {
+                        console.error("Cloud sync error", err);
+                        alert(successMsg + " (Saved locally, but cloud sync failed)");
+                    });
+            } else {
+                alert(successMsg + " (Saved to local tracker)");
+            }
+        }
+
+        if ('serviceWorker' in navigator) {
+            navigator.serviceWorker.register('./sw.js')
+            .then(() => console.log("Service Worker Registered"))
+            .catch(err => console.error("Service Worker Registration Failed:", err));
+        }
+
+        window.addEventListener('offline', updateNetworkStatus);
+        window.addEventListener('online', updateNetworkStatus);
+        updateNetworkStatus();
+
+        function updateNetworkStatus() {
+            const ind = document.getElementById('statusIndicator');
+            if (!navigator.onLine) {
+                ind.innerHTML = `<span class="w-2 h-2 rounded-full bg-red-500 shadow-[0_0_8px_rgba(var(--tw-colors-red-500),0.8)]"></span> Offline - Predictions Unavailable`;
+            } else if (currentUser) {
+
+                ind.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(var(--tw-colors-emerald-500),0.8)]"></span> Analysis Complete`;
+            }
+        }
+    </script>
+</body>
+</html>
