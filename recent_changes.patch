+
+.hero.fireworks-bg h1,
+.hero.fireworks-bg h2,
+.hero.fireworks-bg p {
+    text-shadow: 0 4px 15px rgba(0, 0, 0, 1);
+    z-index: 10;
+}
+
+.hero.fireworks-bg::before {
+    opacity: 0.4;
