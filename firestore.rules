rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAdmin() {
       return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS - Strict Data Controller Ownership Enforced
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || (request.auth != null && resource.data.orgId == request.auth.uid);
      
      allow create: if isOwner(userId) 
                    && request.resource.data.get('isAdmin', false) == false
                    && !request.resource.data.keys().hasAny(['isBanned', 'membershipLevel', 'plan', 'subscription']);
      
      allow update: if (isOwner(userId) 
                        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBanned', 'membershipLevel', 'plan', 'subscription']))
                    || isAdmin();
      
      allow delete: if isOwner(userId) || isAdmin(); 
    }

    // CARTS
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ORDERS
    match /orders/{orderId} {
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'Processing';
       
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
       
      allow update, delete: if isAdmin();
    }

    // INVITES (Corporate/Business linking)
    match /invites/{inviteId} {
      allow read, write: if isAdmin();
    }

    // SONG REQUESTS
    match /song_requests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if isAdmin();
    }

    // PRODUCT STATS
    match /product_stats/{productId} {
      allow read: if true;
      allow create: if request.auth != null 
                    && request.resource.data.keys().hasOnly(['orderedCount'])
                    && request.resource.data.orderedCount is number;
      allow update: if request.auth != null 
                    && request.resource.data.orderedCount > resource.data.orderedCount
                    && request.resource.data.orderedCount is number;
    }
    
    // NEWSLETTER
    match /newsletterSubscribers/{email} {
      allow create, update: if request.resource.data.email == email;
      allow read, delete: if isAdmin();
    }
    
    // SITE STATS
    match /site_stats/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // FEATURE REQUESTS (ezManage)
    match /feature_requests/{requestId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // SCHEDULES (Missing rules added here)
    match /schedules/{scheduleId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // SHIFT NOTES
    match /shift_notes/{noteId} {
      allow read: if request.auth != null && (
          resource.data.authorId == request.auth.uid || 
          (resource.data.orgId != null && resource.data.orgId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId) ||
          isAdmin()
      );
      // Removed allow write: if false to permit client-side testing/usage since Cloud functions alone weren't handling all needs properly per bug report.
      // But adding user/org verification for creation to be safe.
      allow create: if request.auth != null && request.resource.data.orgId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId;
      allow update: if request.auth != null && resource.data.orgId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId;
    }

    // SHIFT GROUPS
    match /shift_groups/{groupId} {
      allow read: if request.auth != null && (resource.data.ownerId == request.auth.uid || groupId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId);
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    
    // SHIFT GROUP REQUESTS
    match /shift_group_requests/{requestId} {
      allow read: if request.auth != null && (
          resource.data.userId == request.auth.uid || 
          get(/databases/$(database)/documents/shift_groups/$(resource.data.groupId)).data.ownerId == request.auth.uid
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/shift_groups/$(resource.data.groupId)).data.ownerId == request.auth.uid;
    }

    // MAINTENANCE LOGS
    match /maintenance_logs/{logId} {
      allow read: if request.auth != null && (
          resource.data.reportedByUid == request.auth.uid ||
          (resource.data.orgId != null && resource.data.orgId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId) ||
          isAdmin()
      );
      allow create: if request.auth != null
                    && request.resource.data.reportedByUid == request.auth.uid
                    && request.resource.data.orgId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId;
      allow update: if request.auth != null && (
          resource.data.reportedByUid == request.auth.uid ||
          (resource.data.orgId != null && resource.data.orgId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId) ||
          isAdmin()
      ) && request.resource.data.orgId == resource.data.orgId;
      allow delete: if request.auth != null && (resource.data.reportedByUid == request.auth.uid || isAdmin());
    }

  }
}
