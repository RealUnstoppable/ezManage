rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAdmin() {
       return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS - Strict Data Controller Ownership Enforced
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || (request.auth != null && resource.data.get('orgId', null) == request.auth.uid);
      
      allow create: if isOwner(userId) 
                    && request.resource.data.get('isAdmin', false) == false
                    && !request.resource.data.keys().hasAny(['isBanned', 'membershipLevel', 'plan', 'subscription']);
      
      allow update: if (isOwner(userId) 
                    && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
                    && request.resource.data.get('isBanned', false) == resource.data.get('isBanned', false)
                    && request.resource.data.get('membershipLevel', 'free') == resource.data.get('membershipLevel', 'free'))
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // SHIFT NOTES
    match /shift_notes/{noteId} {
      allow read: if request.auth != null && (
          resource == null ||
          resource.data.get('authorId', null) == request.auth.uid ||
          (resource.data.get('orgId', null) != null && resource.data.get('orgId', null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if request.auth != null
                    && request.resource.data.get('authorId', null) == request.auth.uid
                    && request.resource.data.get('orgId', null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', null);
      allow update, delete: if request.auth != null && (
          resource.data.get('authorId', null) == request.auth.uid ||
          (resource.data.get('orgId', null) != null && resource.data.get('orgId', null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // GROUPS (Added as requested by user, or handling shift_groups to act as groups)
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.get('authorId', null) == request.auth.uid;
      allow update, delete: if request.auth != null && (
          resource.data.get('authorId', null) == request.auth.uid ||
          resource.data.get('orgId', null) == request.auth.uid ||
          (resource.data.get('orgId', null) != null && resource.data.get('orgId', null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // SHIFT GROUPS
    match /shift_groups/{groupId} {
      allow read: if request.auth != null && (
          resource == null ||
          resource.data.get('ownerId', null) == request.auth.uid ||
          groupId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', null)
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.get('ownerId', null) == request.auth.uid;
    }
    
    // SHIFT GROUP REQUESTS
    match /shift_group_requests/{requestId} {
      allow read: if request.auth != null && (
          resource == null ||
          resource.data.get('userId', null) == request.auth.uid ||
          get(/databases/$(database)/documents/shift_groups/$(resource.data.get('groupId', null))).data.get('ownerId', null) == request.auth.uid
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/shift_groups/$(resource.data.get('groupId', null))).data.get('ownerId', null) == request.auth.uid;
    }

    // MAINTENANCE LOGS
    match /maintenance_logs/{logId} {
      allow read: if request.auth != null && (
          resource == null ||
          resource.data.get('reportedByUid', null) == request.auth.uid ||
          (resource.data.get('orgId', null) != null && resource.data.get('orgId', null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if request.auth != null
                    && request.resource.data.get('reportedByUid', null) == request.auth.uid
                    && request.resource.data.get('orgId', null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', null);
      allow update: if request.auth != null && (
          resource.data.get('reportedByUid', null) == request.auth.uid ||
          (resource.data.get('orgId', null) != null && resource.data.get('orgId', null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', null)) ||
          isAdmin()
      ) && request.resource.data.get('orgId', null) == resource.data.get('orgId', null);
      allow delete: if request.auth != null && (resource.data.get('reportedByUid', null) == request.auth.uid || isAdmin());
    }

    // EMPLOYEES
    match /employees/{empId} {
      allow read: if request.auth != null && (
          resource == null ||
          (resource.data.get('orgId', null) != null && resource.data.get('orgId', null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', null)) ||
          isAdmin()
      );
      allow write: if false;
    }

    // SCHEDULES
    match /schedules/{scheduleId} {
      allow read: if request.auth != null && (
          resource == null ||
          resource.data.get('uid', null) == request.auth.uid ||
          resource.data.get('authorId', null) == request.auth.uid ||
          (resource.data.get('orgId', null) != null && resource.data.get('orgId', null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if request.auth != null
                    && (request.resource.data.get('uid', null) == request.auth.uid || request.resource.data.get('authorId', null) == request.auth.uid);
      allow update: if request.auth != null && (
          resource.data.get('uid', null) == request.auth.uid ||
          resource.data.get('authorId', null) == request.auth.uid ||
          (resource.data.get('orgId', null) != null && resource.data.get('orgId', null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', null)) ||
          isAdmin()
      );
      allow delete: if request.auth != null && (
          resource.data.get('uid', null) == request.auth.uid ||
          resource.data.get('authorId', null) == request.auth.uid ||
          isAdmin()
      );
    }

    // TIME OFF REQUESTS
    match /time_off_requests/{requestId} {
      allow read: if request.auth != null && (
          resource == null ||
          resource.data.get('uid', null) == request.auth.uid ||
          (resource.data.get('orgId', null) == request.auth.uid) ||
          isAdmin()
      );
      allow create: if request.auth != null
                    && request.resource.data.get('uid', null) == request.auth.uid
                    && request.resource.data.get('orgId', null) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', null);
      allow update: if request.auth != null && (
          (resource.data.get('uid', null) == request.auth.uid && request.resource.data.get('status', null) == 'Pending') ||
          (resource.data.get('orgId', null) == request.auth.uid) ||
          isAdmin()
      );
      allow delete: if request.auth != null && (
          (resource.data.get('uid', null) == request.auth.uid && resource.data.get('status', null) == 'Pending') ||
          isAdmin()
      );
    }
  }
}
