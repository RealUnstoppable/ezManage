rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (Firebase Auth UID)
    // Fields:
    //   - username: string (optional, <= 100 chars)
    //   - name: string (optional, <= 100 chars)
    //   - email: string (optional, <= 150 chars)
    //   - orgId: string (optional, <= 128 chars, immutable for regular users)
    //   - role: string (optional, <= 50 chars)
    //   - cloudSyncEnabled: bool (optional)
    //   - aiTrainingEnabled: bool (optional)
    //   - customPresets: list (optional, <= 50 items)
    //   - shiftHistory: list (optional, <= 200 items)
    //   - trackerDraft: map (optional)
    //   - subscription: map (optional, privileged)
    //   - plan: string (optional, <= 50 chars, privileged)
    //   - membershipLevel: string (optional, <= 50 chars, privileged)
    //   - isAdmin: bool (optional, privileged)
    //   - isBanned: bool (optional, privileged)
    //
    // Collection: groups
    // Document ID: {groupId}
    // Fields:
    //   - name: string (optional, <= 100 chars)
    //   - orgId: string (optional, <= 128 chars, immutable on update)
    //   - authorId: string (optional, <= 128 chars)
    //   - description: string (optional, <= 500 chars)
    //
    // Collection: carts
    // Document ID: {userId}
    // Fields:
    //   - items: list (optional, <= 100 items)
    //   - total: number (optional, >= 0)
    //
    // Collection: orders
    // Document ID: {orderId}
    // Fields:
    //   - userId: string (required, auth UID)
    //   - status: string (required, 'Processing' on create)
    //   - items: list (optional, <= 100 items)
    //   - total: number (optional, >= 0)
    //
    // Collection: song_requests
    // Document ID: {requestId}
    // Fields:
    //   - title: string (optional, <= 200 chars)
    //   - songTitle: string (optional, <= 200 chars)
    //   - artist: string (optional, <= 200 chars)
    //   - requesterName: string (optional, <= 100 chars)
    //
    // Collection: product_stats
    // Document ID: {productId}
    // Fields:
    //   - orderedCount: number (required, monotonically increasing)
    //
    // Collection: newsletterSubscribers
    // Document ID: {email}
    // Fields:
    //   - email: string (required, matches document id)
    //
    // Collection: site_stats
    // Document ID: {docId}
    // Admin only write
    //
    // Collection: shift_notes
    // Document ID: {noteId}
    // Fields:
    //   - authorId: string (required, auth UID)
    //   - orgId: string (required, <= 128 chars, immutable on update)
    //   - note: string (optional, <= 2000 chars)
    //   - content: string (optional, <= 2000 chars)
    //   - title: string (optional, <= 200 chars)
    //
    // Collection: shift_groups
    // Document ID: {groupId}
    // Fields:
    //   - ownerId: string (required, auth UID)
    //   - name / groupName: string (optional, <= 100 chars)
    //   - plan: string (optional, <= 50 chars)
    //   - aiEnabled: bool (optional)
    //
    // Collection: shift_group_requests
    // Document ID: {requestId}
    // Fields:
    //   - userId: string (required, auth UID)
    //   - groupId: string (required, <= 128 chars)
    //   - status: string (optional, <= 50 chars)
    //
    // Collection: schedules
    // Document ID: {scheduleId}
    // Fields:
    //   - uid: string (optional, auth UID / manager UID)
    //   - authorId: string (optional, <= 128 chars)
    //   - orgId: string (optional, <= 128 chars, immutable on update)
    //   - date: string (optional, <= 50 chars)
    //   - shifts: list of shift maps (optional, <= 100 items)
    //
    // Collection: tasks
    // Document ID: {taskId}
    // Fields:
    //   - title / task: string (optional, <= 200 chars)
    //   - description: string (optional, <= 2000 chars)
    //   - orgId: string (optional, <= 128 chars, immutable on update)
    //   - assigneeId: string (optional, <= 128 chars)
    //   - assignerId: string (optional, <= 128 chars)
    //   - authorId: string (optional, <= 128 chars)
    //   - status: string (optional, <= 50 chars)
    //
    // Collection: incident_reports
    // Document ID: {reportId}
    // Fields:
    //   - reportedByUid: string (required, auth UID)
    //   - orgId: string (required, <= 128 chars, immutable on update)
    //   - title: string (optional, <= 200 chars)
    //   - description: string (optional, <= 3000 chars)
    //   - severity: string (optional, <= 50 chars)
    //
    // Collection: maintenance / maintenance_logs
    // Document ID: {logId}
    // Fields:
    //   - reportedByUid: string (required, auth UID)
    //   - orgId: string (required, <= 128 chars, immutable on update)
    //   - item: string (optional, <= 200 chars)
    //   - description: string (optional, <= 2000 chars)
    //   - status: string (optional, <= 50 chars)
    //
    // Collection: waste_logs
    // Document ID: {logId}
    // Fields:
    //   - loggedByUid: string (required, auth UID)
    //   - orgId: string (required, <= 128 chars, immutable on update)
    //   - item: string (optional, <= 200 chars)
    //   - reason: string (optional, <= 500 chars)
    //   - cost: number (optional, >= 0)
    //   - quantity: number (optional, >= 0)
    //
    // Collection: time_logs
    // Document ID: {logId}
    // Fields:
    //   - uid: string (required, auth UID)
    //   - orgId: string (required, <= 128 chars, immutable on update)
    //   - hours: number (optional, >= 0)
    //
    // Collection: employees
    // Document ID: {empId}
    // Fields:
    //   - name: string (required, 1-100 chars)
    //   - role: string (required, 1-100 chars)
    //   - orgId: string (required, 1-128 chars, immutable on update)
    //   - email: string (optional, <= 150 chars)
    //   - phone: string (optional, <= 50 chars)
    //   - status: string (optional, <= 50 chars)
    //   - authorId: string (optional, <= 128 chars)
    //
    // Collection: recognitions
    // Document ID: {recognitionId}
    // Fields:
    //   - orgId: string (required, <= 128 chars, immutable on update)
    //   - senderId: string (optional, <= 128 chars)
    //   - receiverId / empId: string (optional, <= 128 chars)
    //   - message: string (optional, <= 1000 chars)
    //
    // Collection: time_off_requests
    // Document ID: {requestId}
    // Fields:
    //   - uid: string (required, auth UID)
    //   - orgId: string (required, <= 128 chars, immutable on update)
    //   - reason: string (optional, <= 1000 chars)
    //   - startDate: string (optional, <= 50 chars)
    //   - endDate: string (optional, <= 50 chars)
    //   - status: string (optional, <= 50 chars)
    //
    // Collection: temperature_logs
    // Document ID: {logId}
    // Fields:
    //   - loggedByUid: string (required, auth UID)
    //   - orgId: string (required, <= 128 chars, immutable on update)
    //   - unit / location: string (optional, <= 100 chars)
    //   - temp / temperature: number (optional)
    //
    // Collection: vendor_deliveries
    // Document ID: {deliveryId}
    // Fields:
    //   - loggedByUid: string (required, auth UID)
    //   - orgId: string (required, <= 128 chars, immutable on update)
    //   - vendorName / vendor: string (optional, <= 150 chars)
    //   - items / notes: string (optional, <= 1000 chars)
    //
    // Collection: announcements
    // Document ID: {announcementId}
    // Fields:
    //   - orgId: string (required, <= 128 chars, immutable on update)
    //   - title: string (optional, <= 200 chars)
    //   - message / content: string (optional, <= 3000 chars)
    //   - authorId: string (optional, <= 128 chars)
    //
    // Collection: shift_marketplace
    // Document ID: {shiftId}
    // Fields:
    //   - orgId: string (required, <= 128 chars, immutable on update)
    //   - originalEmployeeId: string (optional, <= 128 chars)
    //   - coveringEmployeeId: string (optional, <= 128 chars)
    //   - shiftDate: string (optional, <= 50 chars)
    //   - status: string (optional, <= 50 chars)
    //
    // Collection: shift_handoffs
    // Document ID: {handoffId}
    // Fields:
    //   - orgId: string (required, <= 128 chars, immutable on update)
    //   - authorId: string (optional, <= 128 chars)
    //   - notes: string (optional, <= 3000 chars)
    //   - acknowledgedBy: list of UIDs (optional, <= 100 items)
    //
    // Collection: inventory
    // Document ID: {itemId}
    // Fields:
    //   - itemName: string (required, 1-150 chars)
    //   - orgId: string (required, 1-128 chars, immutable on update)
    //   - quantity: number (required)
    //   - threshold: number (optional, >= 0)
    //   - id: string (optional, <= 128 chars)
    //
    // Collection: expenses
    // Document ID: {expenseId}
    // Fields:
    //   - description: string (required, 1-250 chars)
    //   - orgId: string (required, 1-128 chars, immutable on update)
    //   - amount: number or string (required)
    //   - category: string (optional, <= 100 chars)
    //   - loggedByName: string (optional, <= 100 chars)
    //   - loggedByUid: string (optional, <= 128 chars)
    //
    // Collection: feature_requests
    // Document ID: {requestId}
    // Fields:
    //   - uid: string (required, auth UID)
    //   - message: string (required, 1-2000 chars)
    //   - email: string (optional, <= 150 chars)
    //   - status: string (optional, <= 50 chars)
    //
    // Collection: feedbacks
    // Document ID: {feedbackId}
    // Fields:
    //   - comment / message: string (optional, <= 2000 chars)
    //   - rating: number (optional, 1-5)
    //   - empId: string (optional, <= 128 chars)
    //   - empName: string (optional, <= 100 chars)
    //   - orgId: string (optional, <= 128 chars)
    //   - uid / managerId: string (optional, <= 128 chars)
    //
    // Collection: lost_and_found
    // Document ID: {itemId}
    // Fields:
    //   - itemName: string (required, 1-150 chars)
    //   - orgId: string (required, 1-128 chars, immutable on update)
    //   - description: string (optional, <= 1000 chars)
    //   - status: string (optional, <= 50 chars)
    //   - loggedByUid: string (optional, <= 128 chars)
    //   - dateFound: string (optional, <= 50 chars)
    //
    // Collection: certifications
    // Document ID: {certId}
    // Fields:
    //   - empId: string (required, 1-128 chars)
    //   - certName: string (required, 1-150 chars)
    //   - orgId: string (required, 1-128 chars, immutable on update)
    //   - empName: string (optional, <= 100 chars)
    //   - status: string (optional, <= 50 chars)
    //   - expiryDate: string (optional, <= 50 chars)
    //   - issueDate: string (optional, <= 50 chars)
    //
    // Collection: bookings
    // Document ID: {bookingId}
    // Fields:
    //   - customerName / name: string (optional, <= 100 chars)
    //   - customerEmail / email: string (optional, <= 150 chars)
    //   - customerPhone / phone: string (optional, <= 50 chars)
    //   - vehicle: string (optional, <= 100 chars)
    //   - status: string (optional, <= 50 chars)
    //   - userId: string (optional, <= 128 chars)
    //   - orgId: string (optional, <= 128 chars)
    //
    // Collection: quotes
    // Document ID: {quoteId}
    // Fields:
    //   - email: string (optional, <= 150 chars)
    //   - details: string (optional, <= 2000 chars)
    //   - status: string (optional, <= 50 chars)
    //   - userId: string (optional, <= 128 chars)
    //   - orgId: string (optional, <= 128 chars)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return userExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.get('admin', false) == true) ||
        (userExists() && getUserData().get('isAdmin', false) == true)
      );
    }

    function isShiftGroupOwner(groupId) {
      return groupId != null && groupId is string &&
             exists(/databases/$(database)/documents/shift_groups/$(groupId)) &&
             get(/databases/$(database)/documents/shift_groups/$(groupId)).data.get('ownerId', null) == request.auth.uid;
    }

    function isOrgManager(orgId) {
      return isAuthenticated() && orgId != null && orgId is string && (
        request.auth.uid == orgId ||
        isShiftGroupOwner(orgId) ||
        isAdmin()
      );
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && orgId != null && orgId is string && (
        isOrgManager(orgId) ||
        (userExists() && getUserData().get('orgId', null) == orgId)
      );
    }

    function canManageSchedule(data, scheduleId) {
      return isAuthenticated() && (
        isAdmin() ||
        (data.get('orgId', null) != null && isOrgManager(data.get('orgId', null))) ||
        (data.get('orgId', null) == null && (
          data.get('authorId', null) == request.auth.uid ||
          data.get('uid', null) == request.auth.uid ||
          scheduleId.matches('^' + request.auth.uid + '.*')
        ))
      );
    }

    // Type and Bounded String/Collection Helpers
    function validString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function validOptString(mapData, key, minLen, maxLen) {
      return !(key in mapData) || mapData[key] == null ||
             (mapData[key] is string && mapData[key].size() >= minLen && mapData[key].size() <= maxLen);
    }

    function validOptNumber(mapData, key, minVal, maxVal) {
      return !(key in mapData) || mapData[key] == null ||
             (mapData[key] is number && mapData[key] >= minVal && mapData[key] <= maxVal);
    }

    function validOptBool(mapData, key) {
      return !(key in mapData) || mapData[key] == null || mapData[key] is bool;
    }

    function validOptList(mapData, key, maxSize) {
      return !(key in mapData) || mapData[key] == null ||
             (mapData[key] is list && mapData[key].size() <= maxSize);
    }

    function validOptMap(mapData, key) {
      return !(key in mapData) || mapData[key] == null || mapData[key] is map;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return validOptString(data, 'username', 0, 100) &&
             validOptString(data, 'name', 0, 100) &&
             validOptString(data, 'email', 0, 150) &&
             validOptString(data, 'orgId', 0, 128) &&
             validOptString(data, 'role', 0, 50) &&
             validOptBool(data, 'cloudSyncEnabled') &&
             validOptBool(data, 'aiTrainingEnabled') &&
             validOptBool(data, 'isAdmin') &&
             validOptBool(data, 'isBanned') &&
             validOptString(data, 'membershipLevel', 0, 50) &&
             validOptString(data, 'plan', 0, 50) &&
             validOptList(data, 'customPresets', 50) &&
             validOptList(data, 'shiftHistory', 200) &&
             validOptMap(data, 'subscription') &&
             validOptMap(data, 'trackerDraft');
    }

    function isValidGroup(data) {
      return validOptString(data, 'name', 0, 100) &&
             validOptString(data, 'orgId', 0, 128) &&
             validOptString(data, 'authorId', 0, 128) &&
             validOptString(data, 'description', 0, 500);
    }

    function isValidCart(data) {
      return validOptList(data, 'items', 100) &&
             validOptNumber(data, 'total', 0, 1000000);
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.status is string && data.status.size() <= 50 &&
             validOptList(data, 'items', 100) &&
             validOptNumber(data, 'total', 0, 1000000);
    }

    function isValidSongRequest(data) {
      return validOptString(data, 'title', 0, 200) &&
             validOptString(data, 'songTitle', 0, 200) &&
             validOptString(data, 'artist', 0, 200) &&
             validOptString(data, 'requesterName', 0, 100);
    }

    function isValidProductStats(data) {
      return data.orderedCount is number && data.orderedCount >= 0;
    }

    function isValidNewsletter(data, email) {
      return data.email is string && data.email == email && data.email.size() <= 150;
    }

    function isValidShiftNote(data) {
      return validOptString(data, 'authorId', 0, 128) &&
             validOptString(data, 'orgId', 0, 128) &&
             validOptString(data, 'note', 0, 2000) &&
             validOptString(data, 'content', 0, 2000) &&
             validOptString(data, 'title', 0, 200);
    }

    function isValidShiftGroup(data) {
      return data.ownerId is string && data.ownerId.size() <= 128 &&
             validOptString(data, 'name', 0, 100) &&
             validOptString(data, 'groupName', 0, 100) &&
             validOptString(data, 'plan', 0, 50) &&
             validOptBool(data, 'aiEnabled');
    }

    function isValidShiftGroupRequest(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.groupId is string && data.groupId.size() <= 128 &&
             validOptString(data, 'status', 0, 50);
    }

    function isValidSchedule(data) {
      return validOptString(data, 'uid', 0, 128) &&
             validOptString(data, 'authorId', 0, 128) &&
             validOptString(data, 'orgId', 0, 128) &&
             validOptString(data, 'date', 0, 50) &&
             validOptList(data, 'shifts', 100);
    }

    function isValidTask(data) {
      return validOptString(data, 'title', 0, 200) &&
             validOptString(data, 'task', 0, 200) &&
             validOptString(data, 'description', 0, 2000) &&
             validOptString(data, 'orgId', 0, 128) &&
             validOptString(data, 'assigneeId', 0, 128) &&
             validOptString(data, 'assignerId', 0, 128) &&
             validOptString(data, 'authorId', 0, 128) &&
             validOptString(data, 'status', 0, 50);
    }

    function isValidIncidentReport(data) {
      return data.reportedByUid is string && data.reportedByUid.size() <= 128 &&
             data.orgId is string && data.orgId.size() <= 128 &&
             validOptString(data, 'description', 0, 3000) &&
             validOptString(data, 'severity', 0, 50) &&
             validOptString(data, 'title', 0, 200);
    }

    function isValidMaintenanceLog(data) {
      return data.reportedByUid is string && data.reportedByUid.size() <= 128 &&
             data.orgId is string && data.orgId.size() <= 128 &&
             validOptString(data, 'item', 0, 200) &&
             validOptString(data, 'description', 0, 2000) &&
             validOptString(data, 'status', 0, 50);
    }

    function isValidWasteLog(data) {
      return data.loggedByUid is string && data.loggedByUid.size() <= 128 &&
             data.orgId is string && data.orgId.size() <= 128 &&
             validOptString(data, 'item', 0, 200) &&
             validOptString(data, 'reason', 0, 500) &&
             validOptNumber(data, 'cost', 0, 100000) &&
             validOptNumber(data, 'quantity', 0, 100000);
    }

    function isValidTimeLog(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.orgId is string && data.orgId.size() <= 128 &&
             validOptNumber(data, 'hours', 0, 1000);
    }

    function isValidEmployee(data) {
      return validString(data.name, 1, 100) &&
             validString(data.role, 1, 100) &&
             validString(data.orgId, 1, 128) &&
             validOptString(data, 'email', 0, 150) &&
             validOptString(data, 'phone', 0, 50) &&
             validOptString(data, 'status', 0, 50) &&
             validOptString(data, 'authorId', 0, 128);
    }

    function isValidRecognition(data) {
      return data.orgId is string && data.orgId.size() <= 128 &&
             validOptString(data, 'senderId', 0, 128) &&
             validOptString(data, 'receiverId', 0, 128) &&
             validOptString(data, 'empId', 0, 128) &&
             validOptString(data, 'message', 0, 1000);
    }

    function isValidTimeOffRequest(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.orgId is string && data.orgId.size() <= 128 &&
             validOptString(data, 'startDate', 0, 50) &&
             validOptString(data, 'endDate', 0, 50) &&
             validOptString(data, 'reason', 0, 1000) &&
             validOptString(data, 'status', 0, 50);
    }

    function isValidTemperatureLog(data) {
      return data.loggedByUid is string && data.loggedByUid.size() <= 128 &&
             data.orgId is string && data.orgId.size() <= 128 &&
             validOptString(data, 'unit', 0, 100) &&
             validOptString(data, 'location', 0, 100) &&
             validOptNumber(data, 'temp', -100, 300) &&
             validOptNumber(data, 'temperature', -100, 300);
    }

    function isValidVendorDelivery(data) {
      return data.loggedByUid is string && data.loggedByUid.size() <= 128 &&
             data.orgId is string && data.orgId.size() <= 128 &&
             validOptString(data, 'vendorName', 0, 150) &&
             validOptString(data, 'vendor', 0, 150) &&
             validOptString(data, 'items', 0, 1000) &&
             validOptString(data, 'notes', 0, 1000);
    }

    function isValidAnnouncement(data) {
      return data.orgId is string && data.orgId.size() <= 128 &&
             validOptString(data, 'title', 0, 200) &&
             validOptString(data, 'message', 0, 3000) &&
             validOptString(data, 'content', 0, 3000) &&
             validOptString(data, 'authorId', 0, 128);
    }

    function isValidShiftMarketplace(data) {
      return data.orgId is string && data.orgId.size() <= 128 &&
             validOptString(data, 'originalEmployeeId', 0, 128) &&
             validOptString(data, 'coveringEmployeeId', 0, 128) &&
             validOptString(data, 'shiftDate', 0, 50) &&
             validOptString(data, 'status', 0, 50);
    }

    function isValidShiftHandoff(data) {
      return data.orgId is string && data.orgId.size() <= 128 &&
             validOptString(data, 'authorId', 0, 128) &&
             validOptString(data, 'notes', 0, 3000) &&
             validOptList(data, 'acknowledgedBy', 100);
    }

    function isValidInventory(data) {
      return validString(data.itemName, 1, 150) &&
             validString(data.orgId, 1, 128) &&
             data.quantity is number &&
             validOptNumber(data, 'threshold', 0, 1000000) &&
             validOptString(data, 'id', 0, 128);
    }

    function isValidExpense(data) {
      return validString(data.description, 1, 250) &&
             validString(data.orgId, 1, 128) &&
             ((data.amount is number && data.amount >= 0) || (data.amount is string && data.amount.size() <= 50)) &&
             validOptString(data, 'category', 0, 100) &&
             validOptString(data, 'loggedByName', 0, 100) &&
             validOptString(data, 'loggedByUid', 0, 128);
    }

    function isValidFeatureRequest(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             validString(data.message, 1, 2000) &&
             validOptString(data, 'email', 0, 150) &&
             validOptString(data, 'status', 0, 50);
    }

    function isValidFeedback(data) {
      return validOptString(data, 'comment', 0, 2000) &&
             validOptString(data, 'message', 0, 2000) &&
             validOptNumber(data, 'rating', 1, 5) &&
             validOptString(data, 'empId', 0, 128) &&
             validOptString(data, 'empName', 0, 100) &&
             validOptString(data, 'orgId', 0, 128) &&
             validOptString(data, 'uid', 0, 128) &&
             validOptString(data, 'managerId', 0, 128);
    }

    function isValidLostAndFound(data) {
      return validString(data.itemName, 1, 150) &&
             validString(data.orgId, 1, 128) &&
             validOptString(data, 'status', 0, 50) &&
             validOptString(data, 'description', 0, 1000) &&
             validOptString(data, 'loggedByUid', 0, 128) &&
             validOptString(data, 'dateFound', 0, 50);
    }

    function isValidCertification(data) {
      return validString(data.empId, 1, 128) &&
             validString(data.certName, 1, 150) &&
             validString(data.orgId, 1, 128) &&
             validOptString(data, 'empName', 0, 100) &&
             validOptString(data, 'status', 0, 50) &&
             validOptString(data, 'expiryDate', 0, 50) &&
             validOptString(data, 'issueDate', 0, 50);
    }

    function isValidBooking(data) {
      return validOptString(data, 'customerName', 0, 100) &&
             validOptString(data, 'name', 0, 100) &&
             validOptString(data, 'customerEmail', 0, 150) &&
             validOptString(data, 'email', 0, 150) &&
             validOptString(data, 'customerPhone', 0, 50) &&
             validOptString(data, 'phone', 0, 50) &&
             validOptString(data, 'vehicle', 0, 100) &&
             validOptString(data, 'status', 0, 50) &&
             validOptString(data, 'userId', 0, 128) &&
             validOptString(data, 'orgId', 0, 128);
    }

    function isValidQuote(data) {
      return validOptString(data, 'email', 0, 150) &&
             validOptString(data, 'details', 0, 2000) &&
             validOptString(data, 'status', 0, 50) &&
             validOptString(data, 'userId', 0, 128) &&
             validOptString(data, 'orgId', 0, 128);
    }

    // ===============================================================
    // Default Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // USERS: Prevent privilege escalation on isAdmin, isBanned, membershipLevel, plan, subscription, orgId
    match /users/{userId} {
      allow read: if isOwner(userId)
                  || isAdmin()
                  || (userExists() && resource.data.get('orgId', null) != null && resource.data.get('orgId', null) == getUserData().get('orgId', null))
                  || (isAuthenticated() && resource.data.get('orgId', null) != null && isShiftGroupOwner(resource.data.get('orgId', null)))
                  || (isAuthenticated() && resource.data.get('orgId', null) == request.auth.uid);
      allow create: if isAuthenticated()
                    && isOwner(userId)
                    && isValidUser(request.resource.data)
                    && (isAdmin() || (
                        !request.resource.data.keys().hasAny(['isAdmin', 'isBanned', 'membershipLevel', 'plan', 'subscription'])
                        && (!('orgId' in request.resource.data) || request.resource.data.orgId == null || request.resource.data.orgId == request.auth.uid)
                    ));
      allow update: if isAuthenticated()
                    && (isOwner(userId) || (resource.data.get('orgId', null) != null && resource.data.get('orgId', null) == request.auth.uid) || isAdmin())
                    && isValidUser(request.resource.data)
                    && (isAdmin() || (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isBanned', 'membershipLevel', 'plan', 'subscription', 'orgId'])
                    ));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // GROUPS
    match /groups/{groupId} {
      allow read: if isAuthenticated() && (
          resource.data.get('authorId', null) == request.auth.uid ||
          isOrgMember(resource.data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.resource.data.get('authorId', null) == request.auth.uid
                    && (request.resource.data.get('orgId', null) == null || isOrgMember(request.resource.data.get('orgId', null)))
                    && isValidGroup(request.resource.data);
      allow update: if isAuthenticated() && (
          resource.data.get('authorId', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
        && isValidGroup(request.resource.data);
      allow delete: if isAuthenticated() && (
          resource.data.get('authorId', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // CARTS
    match /carts/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidCart(request.resource.data);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ORDERS
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.get('userId', null) == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
                    && request.resource.data.get('userId', null) == request.auth.uid
                    && request.resource.data.get('status', null) == 'Processing'
                    && isValidOrder(request.resource.data);
      allow update: if isAdmin() && isValidOrder(request.resource.data);
      allow delete: if isAdmin();
    }

    // SONG REQUESTS
    match /song_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidSongRequest(request.resource.data);
      allow update: if isAdmin() && isValidSongRequest(request.resource.data);
      allow delete: if isAdmin();
    }

    // PRODUCT STATS
    match /product_stats/{productId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly(['orderedCount'])
                    && isValidProductStats(request.resource.data);
      allow update: if isAuthenticated()
                    && request.resource.data.keys().hasOnly(['orderedCount'])
                    && isValidProductStats(request.resource.data)
                    && request.resource.data.orderedCount > resource.data.orderedCount;
    }

    // NEWSLETTER
    match /newsletterSubscribers/{email} {
      allow read, delete: if isAdmin();
      allow create, update: if isValidNewsletter(request.resource.data, email);
    }

    // SITE STATS
    match /site_stats/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // SHIFT NOTES
    match /shift_notes/{noteId} {
      allow read: if isAuthenticated() && (
          resource.data.get('authorId', null) == request.auth.uid ||
          isOrgMember(resource.data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.resource.data.get('authorId', null) == request.auth.uid
                    && isOrgMember(request.resource.data.get('orgId', null))
                    && isValidShiftNote(request.resource.data);
      allow update: if isAuthenticated() && (
          resource.data.get('authorId', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId', 'authorId'])
        && isValidShiftNote(request.resource.data);
      allow delete: if isAuthenticated() && (
          resource.data.get('authorId', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // SHIFT GROUPS
    match /shift_groups/{groupId} {
      allow read: if isAuthenticated() && (
          resource.data.get('ownerId', null) == request.auth.uid ||
          (userExists() && groupId == getUserData().get('orgId', null)) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.resource.data.get('ownerId', null) == request.auth.uid
                    && isValidShiftGroup(request.resource.data);
      allow update: if isAuthenticated()
                    && (resource.data.get('ownerId', null) == request.auth.uid || isAdmin())
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId'])
                    && isValidShiftGroup(request.resource.data);
      allow delete: if isAuthenticated()
                    && (resource.data.get('ownerId', null) == request.auth.uid || isAdmin());
    }

    // SHIFT GROUP REQUESTS
    match /shift_group_requests/{requestId} {
      allow read: if isAuthenticated() && (
          resource.data.get('userId', null) == request.auth.uid ||
          (resource.data.get('groupId', null) != null && isShiftGroupOwner(resource.data.get('groupId', null))) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.resource.data.get('userId', null) == request.auth.uid
                    && isValidShiftGroupRequest(request.resource.data);
      allow update: if isAuthenticated()
                    && ((resource.data.get('groupId', null) != null && isShiftGroupOwner(resource.data.get('groupId', null))) || isAdmin())
                    && isValidShiftGroupRequest(request.resource.data);
      allow delete: if isAuthenticated() && (
          resource.data.get('userId', null) == request.auth.uid ||
          (resource.data.get('groupId', null) != null && isShiftGroupOwner(resource.data.get('groupId', null))) ||
          isAdmin()
      );
    }

    // SCHEDULES: IDOR Fixed - Only organization managers/shift group owners/authors/admins can create, update, or delete. Org members read-only.
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated() && (
          (resource.data.get('orgId', null) != null && isOrgMember(resource.data.get('orgId', null))) ||
          resource.data.get('uid', null) == request.auth.uid ||
          resource.data.get('authorId', null) == request.auth.uid ||
          scheduleId.matches('^' + request.auth.uid + '.*') ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && canManageSchedule(request.resource.data, scheduleId)
                    && isValidSchedule(request.resource.data);
      allow update: if isAuthenticated()
                    && canManageSchedule(resource.data, scheduleId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
                    && isValidSchedule(request.resource.data);
      allow delete: if isAuthenticated()
                    && canManageSchedule(resource.data, scheduleId);
    }

    // TASKS
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          resource.data.get('assigneeId', null) == request.auth.uid ||
          resource.data.get('assignerId', null) == request.auth.uid ||
          resource.data.get('authorId', null) == request.auth.uid ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && (isOrgMember(request.resource.data.get('orgId', null)) || request.resource.data.get('authorId', null) == request.auth.uid)
                    && isValidTask(request.resource.data);
      allow update: if isAuthenticated() && (
          isOrgManager(resource.data.get('orgId', null)) ||
          resource.data.get('authorId', null) == request.auth.uid ||
          resource.data.get('assignerId', null) == request.auth.uid ||
          resource.data.get('assigneeId', null) == request.auth.uid ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
        && isValidTask(request.resource.data);
      allow delete: if isAuthenticated() && (
          isOrgManager(resource.data.get('orgId', null)) ||
          resource.data.get('authorId', null) == request.auth.uid ||
          resource.data.get('assignerId', null) == request.auth.uid ||
          isAdmin()
      );
    }

    // INCIDENT REPORTS
    match /incident_reports/{reportId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          resource.data.get('reportedByUid', null) == request.auth.uid ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.resource.data.get('reportedByUid', null) == request.auth.uid
                    && isOrgMember(request.resource.data.get('orgId', null))
                    && isValidIncidentReport(request.resource.data);
      allow update: if isAuthenticated() && (
          resource.data.get('reportedByUid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
        && isValidIncidentReport(request.resource.data);
      allow delete: if isAuthenticated() && (
          resource.data.get('reportedByUid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // MAINTENANCE (Alias 1)
    match /maintenance/{logId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          resource.data.get('reportedByUid', null) == request.auth.uid ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.resource.data.get('reportedByUid', null) == request.auth.uid
                    && isOrgMember(request.resource.data.get('orgId', null))
                    && isValidMaintenanceLog(request.resource.data);
      allow update: if isAuthenticated() && (
          resource.data.get('reportedByUid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
        && isValidMaintenanceLog(request.resource.data);
      allow delete: if isAuthenticated() && (
          resource.data.get('reportedByUid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // MAINTENANCE LOGS (Alias 2)
    match /maintenance_logs/{logId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          resource.data.get('reportedByUid', null) == request.auth.uid ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.resource.data.get('reportedByUid', null) == request.auth.uid
                    && isOrgMember(request.resource.data.get('orgId', null))
                    && isValidMaintenanceLog(request.resource.data);
      allow update: if isAuthenticated() && (
          resource.data.get('reportedByUid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
        && isValidMaintenanceLog(request.resource.data);
      allow delete: if isAuthenticated() && (
          resource.data.get('reportedByUid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // WASTE LOGS
    match /waste_logs/{logId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          resource.data.get('loggedByUid', null) == request.auth.uid ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.resource.data.get('loggedByUid', null) == request.auth.uid
                    && isOrgMember(request.resource.data.get('orgId', null))
                    && isValidWasteLog(request.resource.data);
      allow update: if isAuthenticated() && (
          resource.data.get('loggedByUid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
        && isValidWasteLog(request.resource.data);
      allow delete: if isAuthenticated() && (
          resource.data.get('loggedByUid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // TIME LOGS
    match /time_logs/{logId} {
      allow read: if isAuthenticated() && (
          resource.data.get('uid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.resource.data.get('uid', null) == request.auth.uid
                    && isOrgMember(request.resource.data.get('orgId', null))
                    && isValidTimeLog(request.resource.data);
      allow update: if isAuthenticated() && (
          resource.data.get('uid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId', 'uid'])
        && isValidTimeLog(request.resource.data);
      allow delete: if isAuthenticated() && (
          resource.data.get('uid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // EMPLOYEES: IDOR Fixed - Only organization managers/shift group owners/admins can create, edit, or delete. Employees can only read.
    match /employees/{empId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && isOrgManager(request.resource.data.get('orgId', null))
                    && isValidEmployee(request.resource.data);
      allow update: if isAuthenticated()
                    && isOrgManager(resource.data.get('orgId', null))
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
                    && isValidEmployee(request.resource.data);
      allow delete: if isAuthenticated()
                    && isOrgManager(resource.data.get('orgId', null));
    }

    // RECOGNITIONS
    match /recognitions/{recognitionId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && isOrgMember(request.resource.data.get('orgId', null))
                    && (request.resource.data.get('senderId', request.auth.uid) == request.auth.uid || isOrgManager(request.resource.data.get('orgId', null)))
                    && isValidRecognition(request.resource.data);
      allow update: if isAuthenticated() && (
          resource.data.get('senderId', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId', 'senderId'])
        && isValidRecognition(request.resource.data);
      allow delete: if isAuthenticated() && (
          resource.data.get('senderId', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // TIME OFF REQUESTS
    match /time_off_requests/{requestId} {
      allow read: if isAuthenticated() && (
          resource.data.get('uid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.resource.data.get('uid', null) == request.auth.uid
                    && isOrgMember(request.resource.data.get('orgId', null))
                    && isValidTimeOffRequest(request.resource.data);
      allow update: if isAuthenticated() && (
          (resource.data.get('uid', null) == request.auth.uid && resource.data.get('status', 'Pending') == 'Pending') ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId', 'uid'])
        && isValidTimeOffRequest(request.resource.data);
      allow delete: if isAuthenticated() && (
          (resource.data.get('uid', null) == request.auth.uid && resource.data.get('status', 'Pending') == 'Pending') ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // TEMPERATURE LOGS
    match /temperature_logs/{logId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          resource.data.get('loggedByUid', null) == request.auth.uid ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.resource.data.get('loggedByUid', null) == request.auth.uid
                    && isOrgMember(request.resource.data.get('orgId', null))
                    && isValidTemperatureLog(request.resource.data);
      allow update: if isAuthenticated() && (
          resource.data.get('loggedByUid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
        && isValidTemperatureLog(request.resource.data);
      allow delete: if isAuthenticated() && (
          resource.data.get('loggedByUid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // VENDOR DELIVERIES
    match /vendor_deliveries/{deliveryId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          resource.data.get('loggedByUid', null) == request.auth.uid ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.resource.data.get('loggedByUid', null) == request.auth.uid
                    && isOrgMember(request.resource.data.get('orgId', null))
                    && isValidVendorDelivery(request.resource.data);
      allow update: if isAuthenticated() && (
          resource.data.get('loggedByUid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
        && isValidVendorDelivery(request.resource.data);
      allow delete: if isAuthenticated() && (
          resource.data.get('loggedByUid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // ANNOUNCEMENTS: IDOR Fixed - Only managers/authors/admins can create, edit, or delete. Employees can only read.
    match /announcements/{announcementId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          resource.data.get('authorId', null) == request.auth.uid ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && (isOrgManager(request.resource.data.get('orgId', null)) || isAdmin())
                    && isValidAnnouncement(request.resource.data);
      allow update: if isAuthenticated() && (
          (resource.data.get('authorId', null) == request.auth.uid && isOrgManager(resource.data.get('orgId', null))) ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
        && isValidAnnouncement(request.resource.data);
      allow delete: if isAuthenticated() && (
          (resource.data.get('authorId', null) == request.auth.uid && isOrgManager(resource.data.get('orgId', null))) ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // SHIFT MARKETPLACE
    match /shift_marketplace/{shiftId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && isOrgMember(request.resource.data.get('orgId', null))
                    && (request.resource.data.get('originalEmployeeId', request.auth.uid) == request.auth.uid || isOrgManager(request.resource.data.get('orgId', null)))
                    && isValidShiftMarketplace(request.resource.data);
      allow update: if isAuthenticated() && (
          resource.data.get('originalEmployeeId', null) == request.auth.uid ||
          isOrgMember(resource.data.get('orgId', null)) ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId', 'originalEmployeeId'])
        && isValidShiftMarketplace(request.resource.data);
      allow delete: if isAuthenticated() && (
          resource.data.get('originalEmployeeId', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // SHIFT HANDOFFS
    match /shift_handoffs/{handoffId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && isOrgMember(request.resource.data.get('orgId', null))
                    && (request.resource.data.get('authorId', request.auth.uid) == request.auth.uid || isOrgManager(request.resource.data.get('orgId', null)))
                    && isValidShiftHandoff(request.resource.data);
      allow update: if isAuthenticated() && (
          resource.data.get('authorId', null) == request.auth.uid ||
          (isOrgMember(resource.data.get('orgId', null)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgedBy'])) ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId', 'authorId'])
        && isValidShiftHandoff(request.resource.data);
      allow delete: if isAuthenticated() && (
          resource.data.get('authorId', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // INVENTORY: Scoped by orgId. Org members can read; managers/admins can write.
    match /inventory/{itemId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && isOrgManager(request.resource.data.get('orgId', null))
                    && isValidInventory(request.resource.data);
      allow update: if isAuthenticated()
                    && isOrgManager(resource.data.get('orgId', null))
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
                    && isValidInventory(request.resource.data);
      allow delete: if isAuthenticated()
                    && isOrgManager(resource.data.get('orgId', null));
    }

    // EXPENSES: Scoped by orgId. Org members can read; managers/admins can write.
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && isOrgManager(request.resource.data.get('orgId', null))
                    && isValidExpense(request.resource.data);
      allow update: if isAuthenticated()
                    && isOrgManager(resource.data.get('orgId', null))
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
                    && isValidExpense(request.resource.data);
      allow delete: if isAuthenticated()
                    && isOrgManager(resource.data.get('orgId', null));
    }

    // FEATURE REQUESTS: Users can create/read their own; admins can read/update/delete.
    match /feature_requests/{requestId} {
      allow read: if isAuthenticated() && (
          resource.data.get('uid', null) == request.auth.uid ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.resource.data.get('uid', null) == request.auth.uid
                    && isValidFeatureRequest(request.resource.data);
      allow update: if isAdmin() && isValidFeatureRequest(request.resource.data);
      allow delete: if isAdmin();
    }

    // FEEDBACKS: Users can submit feedback (uid == request.auth.uid); admins/managers can read and manage.
    match /feedbacks/{feedbackId} {
      allow read: if isAuthenticated() && (
          resource.data.get('uid', null) == request.auth.uid ||
          resource.data.get('managerId', null) == request.auth.uid ||
          (resource.data.get('orgId', null) != null && isOrgManager(resource.data.get('orgId', null))) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && (request.resource.data.get('uid', request.auth.uid) == request.auth.uid || request.resource.data.get('managerId', request.auth.uid) == request.auth.uid)
                    && isValidFeedback(request.resource.data);
      allow update: if isAuthenticated() && (
          (resource.data.get('orgId', null) != null && isOrgManager(resource.data.get('orgId', null))) ||
          isAdmin()
      ) && isValidFeedback(request.resource.data);
      allow delete: if isAuthenticated() && (
          (resource.data.get('orgId', null) != null && isOrgManager(resource.data.get('orgId', null))) ||
          isAdmin()
      );
    }

    // LOST AND FOUND: Scoped by orgId.
    match /lost_and_found/{itemId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && isOrgMember(request.resource.data.get('orgId', null))
                    && request.resource.data.get('loggedByUid', request.auth.uid) == request.auth.uid
                    && isValidLostAndFound(request.resource.data);
      allow update: if isAuthenticated() && (
          resource.data.get('loggedByUid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
        && isValidLostAndFound(request.resource.data);
      allow delete: if isAuthenticated() && (
          resource.data.get('loggedByUid', null) == request.auth.uid ||
          isOrgManager(resource.data.get('orgId', null)) ||
          isAdmin()
      );
    }

    // CERTIFICATIONS: Scoped by orgId.
    match /certifications/{certId} {
      allow read: if isAuthenticated() && (
          isOrgMember(resource.data.get('orgId', null)) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && isOrgManager(request.resource.data.get('orgId', null))
                    && isValidCertification(request.resource.data);
      allow update: if isAuthenticated()
                    && isOrgManager(resource.data.get('orgId', null))
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgId'])
                    && isValidCertification(request.resource.data);
      allow delete: if isAuthenticated()
                    && isOrgManager(resource.data.get('orgId', null));
    }

    // BOOKINGS: Scoped to owner or manager/admin.
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
          resource.data.get('userId', null) == request.auth.uid ||
          (resource.data.get('orgId', null) != null && isOrgManager(resource.data.get('orgId', null))) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && (request.resource.data.get('userId', request.auth.uid) == request.auth.uid || isAdmin() || (request.resource.data.get('orgId', null) != null && isOrgManager(request.resource.data.get('orgId', null))))
                    && isValidBooking(request.resource.data);
      allow update: if isAuthenticated() && (
          resource.data.get('userId', null) == request.auth.uid ||
          (resource.data.get('orgId', null) != null && isOrgManager(resource.data.get('orgId', null))) ||
          isAdmin()
      ) && isValidBooking(request.resource.data);
      allow delete: if isAuthenticated() && (
          (resource.data.get('orgId', null) != null && isOrgManager(resource.data.get('orgId', null))) ||
          isAdmin()
      );
    }

    // QUOTES: Scoped to owner or manager/admin.
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() && (
          resource.data.get('userId', null) == request.auth.uid ||
          (resource.data.get('orgId', null) != null && isOrgManager(resource.data.get('orgId', null))) ||
          isAdmin()
      );
      allow create: if isAuthenticated()
                    && (request.resource.data.get('userId', request.auth.uid) == request.auth.uid || isAdmin() || (request.resource.data.get('orgId', null) != null && isOrgManager(request.resource.data.get('orgId', null))))
                    && isValidQuote(request.resource.data);
      allow update: if isAuthenticated() && (
          (resource.data.get('orgId', null) != null && isOrgManager(resource.data.get('orgId', null))) ||
          isAdmin()
      ) && isValidQuote(request.resource.data);
      allow delete: if isAuthenticated() && (
          (resource.data.get('orgId', null) != null && isOrgManager(resource.data.get('orgId', null))) ||
          isAdmin()
      );
    }

  }
}
